{
  "name": "dsh-cost-meter",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "DSH 花费计量：按官方单价与波峰/波谷时段计费，在状态栏显示本轮/会话花费、当前时段与账户余额",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "check": "node scripts/check-real-log.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "js-yaml": "^4.1.0",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
